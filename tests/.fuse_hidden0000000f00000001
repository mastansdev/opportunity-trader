    engine.process_tick("TCS", "1", 112.0, _t(9, 31, 30))
    engine.process_tick("TCS", "1", 111.0, _t(9, 32, 0))

    # Note: _feed_orb_range always injects a fixed 105.0 tick, so
    # HFCL's actual ORB range here ends up [90.0, 105.0] regardless
