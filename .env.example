DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# Optional -- paid Claude Haiku news classifier. Leave unset to run the
# FREE keyword classifier (news still works, display-only, no blocking).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# News store location (news_bot/news_store.py).
#   - LOCAL: leave unset -> a SQLite file at data/news.db is used.
#   - RAILWAY / CLOUD: Railway's Postgres plugin sets DATABASE_URL
#     automatically for the news-engine service. To point the brain
#     bot (this PC) at that SAME cloud database, copy the value of
#     Railway's DATABASE_URL here. postgres:// URLs are accepted and
#     normalized to postgresql:// automatically.
# DATABASE_URL=postgresql://user:password@host:5432/railway
