DHAN_CLIENT_ID=your_client_id_here
DHAN_ACCESS_TOKEN=your_access_token_here

# ---------------------------------------------------------------
# OPTIONAL -- stop generating the token by hand every morning
# ---------------------------------------------------------------
# Set these two and the bot mints its own 24-hour Dhan access token at
# startup, with no browser and no daily step from you.
#
#   1. Dhan Web -> My Profile -> "Access DhanHQ APIs" -> Setup TOTP
#   2. Confirm with the OTP, then scan the QR into an authenticator
#   3. Copy the SECRET shown beside the QR into DHAN_TOTP_SECRET
#   4. DHAN_PIN is your normal 6-digit Dhan pin
#
# Leave them blank and nothing changes -- the bot uses
# DHAN_ACCESS_TOKEN above, exactly as before. If the mint fails for any
# reason it falls back to that token too, so this can never stop a
# morning. Check it with:  py tools/dhan_token_check.py
#
# NOTE: the API KEY / SECRET toggle on Dhan Web is NOT the automatic
# option it looks like -- its token flow still needs a browser login
# every day. TOTP is the one that removes you from the loop.
# DHAN_PIN=
# DHAN_TOTP_SECRET=

# Optional -- paid Claude Haiku news classifier. Leave unset to run the
# FREE keyword classifier (news still works, display-only, no blocking).
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# News store location (news_bot/news_store.py).
#   - LOCAL: leave unset -> a SQLite file at data/news.db is used.
#   - RAILWAY / CLOUD: Railway's Postgres plugin sets DATABASE_URL
#     automatically for the news-engine service. To point the brain
#     bot (this PC) at that SAME cloud database, copy the value of
#     Railway's DATABASE_URL here. postgres:// URLs are accepted and
#     normalized to postgresql:// automatically.
# DATABASE_URL=postgresql://user:password@host:5432/railway
